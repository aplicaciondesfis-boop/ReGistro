rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember(memberUids) {
      return isAuthenticated() && (request.auth.uid in memberUids);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function householdMember(householdId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    function validJoin(householdId) {
      let invite = get(/databases/$(database)/documents/invitations/$(request.resource.data.joinToken)).data;
      return invite.householdId == householdId && invite.isRevoked == false &&
        invite.createdByUid == resource.data.adminUid &&
        invite.role in ['editor', 'colaborador', 'lector'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'joinToken']) &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.members.diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.members[request.auth.uid] == invite.role;
    }

    function validHouseholdName(name) {
      return name is string && name.size() <= 60 && name.matches('.*[^[:space:]].*');
    }

    function householdAdmin(householdId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/households/$(householdId)).data.adminUid == request.auth.uid;
    }

    function canReadFinance(data) {
      return isAuthenticated() && (
        (data.householdId == 'personal' && isMember(data.memberUids)) ||
        (data.householdId != 'personal' && householdMember(data.householdId))
      );
    }

    function canWriteSharedFinance(data) {
      let household = get(/databases/$(database)/documents/households/$(data.householdId)).data;
      return request.auth.uid in household.memberUids && (
        request.auth.uid == household.adminUid ||
        household.get('members', {}).get(request.auth.uid, '') == 'editor' ||
        isMember(data.get('memberUids', []))
      );
    }

    function canWriteFinance(data) {
      return isAuthenticated() && (data.householdId == 'personal'
        ? isMember(data.memberUids) : canWriteSharedFinance(data));
    }

    function sameFinanceScope() {
      return request.resource.data.householdId == resource.data.householdId &&
        request.resource.data.get('memberUids', []) == resource.data.get('memberUids', []) &&
        request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null);
    }

    function shoppingCollection(type) {
      return type in ['shopping_lists', 'shopping_needs', 'shopping_promotions', 'shopping_keys'];
    }

    function validShopping(type) {
      let d = request.resource.data;
      return d.lastModifiedByUid == request.auth.uid && d.updatedAt is timestamp && (
        (type == 'shopping_keys' && (d.activeNeedId == null || d.activeNeedId is string)) ||
        (type == 'shopping_lists' && d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
          d.status in ['active', 'completed'] && d.needIds is list && d.needIds.size() <= 300) ||
        (type == 'shopping_needs' && d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
          d.done is bool && d.cancelled is bool && d.listIds is list && d.listIds.size() <= 30 &&
          (d.quantity == null || (d.quantity is number && d.quantity > 0 && d.quantity <= 1000000)) &&
          d.unit in ['', 'kg', 'l', 'unidad'] && d.fulfilled is number && d.fulfilled >= 0) ||
        (type == 'shopping_promotions' && d.store is string && d.store.size() > 0 && d.store.size() <= 120 &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.type in ['cashback', 'discount'] &&
          (d.percent == null || (d.percent is number && d.percent >= 0 && d.percent <= 100)) &&
          d.weekdays is list && d.weekdays.size() <= 7 && d.disabled is bool)
      );
    }

    // Households
    match /households/{householdId} {
      allow read: if isMember(resource.data.memberUids);
      allow create: if isAuthenticated() && householdId != 'personal' &&
                    request.resource.data.adminUid == request.auth.uid &&
                    request.resource.data.memberUids == [request.auth.uid] &&
                    validHouseholdName(request.resource.data.name);
      allow update: if isAuthenticated() &&
        ((isOwner(resource.data.adminUid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          validHouseholdName(request.resource.data.name)) ||
         (!isMember(resource.data.memberUids) && validJoin(householdId)));
      allow delete: if isOwner(resource.data.adminUid);
    }

    match /households/{householdId}/{type}/{recordId} {
      allow read: if shoppingCollection(type) && householdMember(householdId);
      allow create: if shoppingCollection(type) && householdMember(householdId) && validShopping(type) &&
        (type == 'shopping_keys' || request.resource.data.createdByUid == request.auth.uid);
      allow update: if shoppingCollection(type) && householdMember(householdId) && validShopping(type) &&
        request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null);
      allow delete: if false;
    }

    match /users/{userId}/{type}/{recordId} {
      allow read: if shoppingCollection(type) && isOwner(userId);
      allow create: if shoppingCollection(type) && isOwner(userId) && validShopping(type) &&
        (type == 'shopping_keys' || request.resource.data.createdByUid == request.auth.uid);
      allow update: if shoppingCollection(type) && isOwner(userId) && validShopping(type) &&
        request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null);
      allow delete: if false;
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if canReadFinance(resource.data);
      allow create: if canWriteFinance(request.resource.data) &&
                    request.resource.data.createdByUid == request.auth.uid;
      allow update: if canWriteFinance(resource.data) && sameFinanceScope();
      allow delete: if canWriteFinance(resource.data);
    }

    // Purchase Line Items
    match /purchase_items/{itemId} {
      allow read: if canReadFinance(resource.data);
      allow create: if canWriteFinance(request.resource.data);
      allow update: if canWriteFinance(resource.data) && sameFinanceScope();
      allow delete: if canWriteFinance(resource.data);
    }

    // Obligations
    match /obligations/{obligationId} {
      allow read: if canReadFinance(resource.data);
      allow create: if canWriteFinance(request.resource.data) &&
                    request.resource.data.createdByUid == request.auth.uid;
      allow update: if canWriteFinance(resource.data) && sameFinanceScope();
      allow delete: if canWriteFinance(resource.data);
    }

    // Invitations
    match /invitations/{invitationId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
                    request.resource.data.createdByUid == request.auth.uid &&
                    householdAdmin(request.resource.data.householdId) &&
                    invitationId.matches('^[A-Z0-9]{1,8}$') &&
                    request.resource.data.isRevoked == false &&
                    request.resource.data.role in ['editor', 'colaborador', 'lector'];
      allow update: if householdAdmin(resource.data.householdId) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRevoked']) &&
                    request.resource.data.isRevoked is bool;
      allow delete: if isAuthenticated() && resource.data.createdByUid == request.auth.uid;
    }
  }
}
